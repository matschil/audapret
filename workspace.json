{
  "version": 1,
  "projects": {
    "study-data-manager": {
      "root": "apps/study-data-manager",
      "sourceRoot": "apps/study-data-manager/src",
      "projectType": "application",
      "prefix": "study-data-manager",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@nrwl/node:build",
          "options": {
            "outputPath": "dist/apps/study-data-manager",
            "main": "apps/study-data-manager/src/main.ts",
            "tsConfig": "apps/study-data-manager/tsconfig.app.json",
            "assets": ["apps/study-data-manager/src/assets"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "extractLicenses": true,
              "inspect": false,
              "fileReplacements": [
                {
                  "replace": "apps/study-data-manager/src/environments/environment.ts",
                  "with": "apps/study-data-manager/src/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@nrwl/node:execute",
          "options": {
            "host": "0.0.0.0",
            "buildTarget": "study-data-manager:build"
          }
        },
        "lint": {
          "builder": "@nrwl/linter:lint",
          "options": {
            "linter": "eslint",
            "config": "apps/study-data-manager/.eslintrc",
            "tsConfig": [
              "apps/study-data-manager/tsconfig.app.json",
              "apps/study-data-manager/tsconfig.spec.json"
            ],
            "exclude": ["**/node_modules/**", "!apps/study-data-manager/**"]
          }
        },
        "test": {
          "builder": "@nrwl/jest:jest",
          "options": {
            "jestConfig": "apps/study-data-manager/jest.config.js",
            "tsConfig": "apps/study-data-manager/tsconfig.spec.json"
          }
        }
      }
    },
