    "study-data-manager-client": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/study-data-manager-client",
      "sourceRoot": "apps/study-data-manager-client/src",
      "prefix": "audapret",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/apps/study-data-manager-client",
            "index": "apps/study-data-manager-client/src/index.html",
            "main": "apps/study-data-manager-client/src/main.ts",
            "polyfills": "apps/study-data-manager-client/src/polyfills.ts",
            "tsConfig": "apps/study-data-manager-client/tsconfig.app.json",
            "aot": false,
            "assets": [
              "apps/study-data-manager-client/src/favicon.ico",
              "apps/study-data-manager-client/src/assets"
            ],
            "styles": ["apps/study-data-manager-client/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "apps/study-data-manager-client/src/environments/environment.ts",
                  "with": "apps/study-data-manager-client/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "host": "0.0.0.0",
            "browserTarget": "study-data-manager-client:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "study-data-manager-client:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "study-data-manager-client:build"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "apps/study-data-manager-client/tsconfig.app.json",
              "apps/study-data-manager-client/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**",
              "!apps/study-data-manager-client/**"
            ]
          }
        },
        "test": {
          "builder": "@nrwl/jest:jest",
          "options": {
            "jestConfig": "apps/study-data-manager-client/jest.config.js",
            "tsConfig": "apps/study-data-manager-client/tsconfig.spec.json",
            "setupFile": "apps/study-data-manager-client/src/test-setup.ts"
          }
        }
      }
    },
