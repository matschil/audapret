FROM node:10-alpine
WORKDIR /app 
ADD package.json /app/package.json
RUN npm config set registry http://registry.npmjs.org
RUN npm install
ADD . /app/
ENV STUDY_DATA_MANAGER_ADDRESS http://study-data-manager
ENV OURA_ADAPTER_DB oura_adapter_db
ENV OURA_ADAPTER_ADDRESS http://oura-adapter

CMD node=dev npm start oura-adapter
