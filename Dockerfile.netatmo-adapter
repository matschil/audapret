FROM node:10-alpine
WORKDIR /app 
ADD package.json /app/package.json
RUN npm config set registry http://registry.npmjs.org
RUN npm install
ADD . /app/
ENV STUDY_DATA_MANAGER_ADDRESS http://study-data-manager
ENV NETATMO_ADAPTER_DB netatmo_adapter_db
ENV NETATMO_ADAPTER_ADDRESS http://netatmo-adapter

CMD node=dev npm start netatmo-adapter
